+
+// on ALTAZM/ALTALT mounts pulse guide rates only act through the tracking rate
+// calculation, recalculate now instead of waiting for the next poll() (up to 1s)
+void Mount::pulseGuideChanged() {
+  if (transform.mountType == ALTAZM || transform.mountType == ALTALT) updateTrackingRates(); else update();
+}
