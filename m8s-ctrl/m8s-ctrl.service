[Unit]
Description=API de commande M8S (monture OnStep en serie LX200 + plate solving ASTAP)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/m8s-ctrl
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
